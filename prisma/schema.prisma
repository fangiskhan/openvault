// OpenVault data model.
// Provider is SQLite for zero-setup local/self-host. For Vercel/Postgres,
// change provider to "postgresql" and set DATABASE_URL (see .env.example).
// We use `prisma db push` (no migration files) so switching providers is painless.
// NOTE: no Prisma `enum` types — they aren't supported on SQLite. Enumerated
// fields are plain strings, validated in the app with zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String?   @default("#8b7cf6")
  health      String? // manual RAG override: green | amber | red — shown ALONGSIDE the computed rollup, never merged
  healthNote  String?
  healthSetAt DateTime?
  ownerAccountId String? // account that owns/maintains this project (routing + find_mcp)
  mcpUrl         String? // this project's own MCP endpoint, if it exposes one
  repoUrl        String? // where the real code lives, e.g. https://github.com/x/y —
  // so a refusal can name the repo to open a PR against instead of saying
  // "open a PR" to someone with no way to know where.
  // How the code mirror is written.
  //   "workspace" — anyone approved may sync_code. Correct for projects with no
  //                 git remote, and the only mode that existed at first.
  //   "replica"   — the mirror is a DERIVED copy of one commit, written solely
  //                 by CI. Nothing can live here that is not in git, so
  //                 mirror-only work (and losing it) stops being possible.
  mirrorMode     String    @default("workspace")
  mirrorWriter   String? // in replica mode, the only account allowed to sync
  mirrorRef      String? // the commit the mirror was last fully synced to
  mirrorSyncedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items            Item[]
  files            FileAsset[]
  codeFiles        CodeFile[]
  codeVersions     CodeVersion[]
  codeSuggestions  CodeSuggestion[]
  workIntents      WorkIntent[]
  skills        ProjectSkill[]
  relationsFrom ProjectRelation[] @relation("fromProject")
  relationsTo   ProjectRelation[] @relation("toProject")
}

// ---- Shared code layer ----
// A synced snapshot of one source file, pushed by an agent (sync_code) so every
// other connected agent can browse the project's code over MCP — no repeated
// git pulls. (projectId, path) is the identity; hash detects staleness.
model CodeFile {
  id        String   @id @default(cuid())
  projectId String
  path      String // repo-relative, forward slashes, validated (no traversal)
  // Files larger than the per-chunk cap are stored as several rows and
  // reassembled on read, so a 1.2 MB module still lands in the mirror instead
  // of being silently missing. part 0 is the whole file for ordinary sizes.
  part      Int      @default(0)
  parts     Int      @default(1) // how many rows this file spans
  content   String
  hash      String // sha256 of the WHOLE file — change detection via get_code_map
  size      Int // total size of the whole file, not of this chunk
  ref       String? // branch/commit label the syncing agent reported
  syncedBy  String? // username/actor that pushed this version
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path, part])
  @@index([projectId])
  @@index([projectId, path])
}

// A working convention this project expects its agents to follow: how to run
// the tests, the review checklist, the deploy steps. Stored as a SKILL.md body
// so it can be read in-session over MCP (no install) or downloaded into
// ~/.claude/skills/. The point is that conventions travel WITH the project:
// whoever connects next inherits them instead of rediscovering them.
model ProjectSkill {
  id          String   @id @default(cuid())
  projectId   String
  name        String // kebab-case; becomes the skill folder / slash-command name
  description String // when to use it — this is what makes an agent reach for it
  body        String // markdown instructions
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

// Every version a mirrored file has ever been replaced by. The mirror itself is
// one slot per path, which silently destroyed work that existed ONLY in the
// mirror when an unrelated commit pushed a different version of the same path.
// A single slot is fine; a single slot with no undo is not.
model CodeVersion {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String // the full previous content, kept whole (versions are not chunked)
  hash      String
  size      Int
  ref       String? // the ref this superseded version carried
  syncedBy  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, path, createdAt])
}

// A proposed change to code, from someone who cannot (or should not) write it
// themselves. This is the answer to the question replica mode raises: if the
// mirror is a read-only copy of git, where does an agent's change GO?
//
// It goes here. The vault never writes to git — the project owner is the
// bridge. An agent proposes, the owner reviews, the owner's agent applies the
// edits to the real checkout, and CI mirrors the result on merge. No stored
// git credential, no merge engine, and nothing lands that a human did not
// approve on their own machine.
//
// Edits are content-anchored ("this text becomes that text"), never line
// numbers: a suggestion may sit for days while the file moves underneath it,
// and a stale coordinate still resolves — silently, to the wrong code.
model CodeSuggestion {
  id         String  @id @default(cuid())
  projectId  String
  path       String
  edits      String // JSON: [{ before, after }], applied in order
  reason     String // why — required, and mirrored into a linked note
  title      String?
  baseHash   String? // mirror content hash the edits were verified against
  baseRef    String?
  status     String  @default("open") // open | approved | rejected | applied | withdrawn
  suggestedBy String
  reviewedBy String?
  reviewNote String?
  noteItemId String? // the Item carrying the reason into the knowledge graph
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// An agent's declared unit of work: "I am changing these files to do X".
// Other agents see active intents (get_active_work) before touching the same
// paths — coordination without a human relay or a Git lock. Finished work is
// submitted for review (in_review); an owner/executive approves it (done) or
// requests changes — the merge/push to git happens only after approval.
model WorkIntent {
  id         String    @id @default(cuid())
  projectId  String
  actor      String // who is doing the work (account username or declared agent)
  intent     String // what they're doing, in one or two sentences
  paths      String    @default("[]") // JSON array of repo-relative paths being touched
  status     String    @default("in_progress") // planning | in_progress | in_review | done | abandoned
  reviewedBy String? // owner/executive who approved (null = never reviewed)
  reviewNote String? // reviewer feedback (esp. on request_changes)
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// A directed connection between two projects. Connected projects can resolve
// wikilinks across the boundary and be included when search scope = "connected".
model ProjectRelation {
  id            String   @id @default(cuid())
  fromProjectId String
  toProjectId   String
  kind          String   @default("related") // related | depends | parent | shares
  createdAt     DateTime @default(now())

  fromProject Project @relation("fromProject", fields: [fromProjectId], references: [id], onDelete: Cascade)
  toProject   Project @relation("toProject", fields: [toProjectId], references: [id], onDelete: Cascade)

  @@unique([fromProjectId, toProjectId])
  @@index([toProjectId])
}

// The unified content record. A note, meeting minute, task, chat message,
// uploaded file, spreadsheet, risk, or generated briefing are all Items — so
// integrations (Slack/Jira/GitHub) and uploads just create Items and inherit
// search/links for free.
model Item {
  id        String    @id @default(cuid())
  projectId String
  type      String    @default("note") // note | meeting | task | message | file | spreadsheet | risk | briefing
  source    String    @default("local") // local | upload | slack | jira | github
  title     String
  body      String    @default("") // markdown
  sourceRef String? // external id / url for integrated items
  metadata  String? // JSON string (parsed spreadsheet sheets, risk meta, briefing doc)
  status    String? // task: open|blocked|done · risk: open|mitigating|accepted|closed
  dueAt     DateTime?
  closedAt  DateTime?
  assigneeAccountId String? // account a flag/request is addressed to (simple inbox routing; no FK)
  // Authorship, stored as plain usernames so the record survives a rename or a
  // deleted account (same reasoning as AuditEvent). "who + when" on the note
  // itself; the audit trail keeps the fuller history.
  createdBy String?
  updatedBy String?
  // Optional semantic layer (see src/lib/embeddings.ts). JSON text rather than
  // a pgvector column so one schema still serves SQLite and Postgres.
  // embedHash records which title+body the vector was built from, so a
  // re-embed only touches notes that actually changed.
  embedding String?
  embedHash String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outLinks Link[]      @relation("fromItem")
  inLinks  Link[]      @relation("toItem")
  tags     ItemTag[]
  files    FileAsset[]

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([assigneeAccountId])
}

// A wikilink edge. toItemId is null for an unresolved ("ghost") link.
model Link {
  id          String   @id @default(cuid())
  fromItemId  String
  toItemId    String?
  targetTitle String // raw [[target]] text, used to (re)resolve links
  createdAt   DateTime @default(now())

  fromItem Item  @relation("fromItem", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item? @relation("toItem", fields: [toItemId], references: [id], onDelete: SetNull)

  @@index([fromItemId])
  @@index([toItemId])
  @@index([targetTitle])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

// Uploaded file (Excel/CSV/PDF/etc.). The original lives in blob storage
// (local disk when self-hosted, Vercel Blob in the cloud); parsed spreadsheet
// data is stored as JSON on the associated spreadsheet Item's metadata.
model FileAsset {
  id         String   @id @default(cuid())
  projectId  String
  itemId     String?
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ---- Accounts, approval & audit (multi-user identity layer) ----
// A person or agent with an identity on this server. Accounts are requested
// (status=pending) and must be approved by an owner/executive before they can
// authenticate via a per-account token. The owner is the root authority; owners
// appoint executives, who may also approve accounts.
model Account {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String?
  role         String    @default("member") // owner | executive | member
  status       String    @default("pending") // pending | approved | revoked
  // SHA-256 of the per-account bearer key. Plaintext is returned exactly once
  // (at registration / regeneration) and never stored — a leaked DB or backup
  // yields no working credentials. Null = no usable token (regenerate to issue).
  tokenHash    String?   @unique
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvedBy Account?  @relation("approver", fields: [approvedById], references: [id])
  approved   Account[] @relation("approver")

  @@index([status])
}

// Append-only accountability log. NEVER updated or deleted. Records who did what
// to whom (notably who approved which account) so a mistaken approval traces to
// its approver. Identities are stored as plain strings so the record survives a
// later rename or deletion.
model AuditEvent {
  id        String   @id @default(cuid())
  action    String // register | approve | revoke | appoint_executive | bootstrap_owner
  actor     String? // who performed the action (username)
  target    String? // who/what it was about (username)
  detail    String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([target])
}
